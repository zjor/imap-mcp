# Copy to deploy/.env (git-ignored) and fill in. Used by the manual fallback
# scripts in deploy/scripts/. CI uses GitHub secrets with the same names.
# Write values without quotes.

# Public host name of the server, without scheme or path.
INGRESS_HOST=mail-mcp.example.com
# Allowed IMAP servers, comma-separated host:port.
IMAP_MCP_IMAP_HOSTS=imap.example.com:993
# Bearer tokens, comma-separated, one per person (openssl rand -hex 32).
IMAP_MCP_ACCESS_TOKENS=change-me
# Optional. Only for IMAP servers without SPECIAL-USE; empty means auto.
IMAP_MCP_DRAFTS_FOLDER=
IMAP_MCP_SENT_FOLDER=
