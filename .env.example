# Copy to .env.local (git-ignored) and fill in. Never commit .env.local.
# The server reads .env.local from its working directory; real environment
# variables win over the file.

# --- Server ---------------------------------------------------------------
# Listen address. Plain HTTP is allowed only on loopback unless
# IMAP_MCP_INSECURE_HTTP=true (TLS proxy on the same host or Docker network).
IMAP_MCP_LISTEN=127.0.0.1:8787
# Required. Allowed IMAP hosts, comma-separated host:port (TLS 993 or STARTTLS 143).
IMAP_MCP_IMAP_HOSTS=imap.example.com:993
# Required. Bearer tokens, comma-separated, one per person.
# Generate one with: openssl rand -hex 32
IMAP_MCP_ACCESS_TOKENS=change-me-to-a-long-random-token
# Base URL used in download_url and upload_url. Default: http://<listen>.
IMAP_MCP_PUBLIC_URL=http://127.0.0.1:8787
# Limit for one upload request (all files together).
IMAP_MCP_MAX_UPLOAD=25MB
# Override when the IMAP server has no SPECIAL-USE. Empty means auto.
IMAP_MCP_DRAFTS_FOLDER=
IMAP_MCP_SENT_FOLDER=
# Built-in TLS (PEM files). Set both or neither.
IMAP_MCP_TLS_CERT=
IMAP_MCP_TLS_KEY=
IMAP_MCP_INSECURE_HTTP=false
# Parallel IMAP sessions per username; extra requests wait.
IMAP_MCP_MAX_SESSIONS_PER_USER=4
# debug, info, warn, error
IMAP_MCP_LOG_LEVEL=info
# json or text
IMAP_MCP_LOG_FORMAT=json

# --- Client (scripts/imap-mcp-headers.sh and scripts/imap-mcp-curl) --------
# One of the tokens in IMAP_MCP_ACCESS_TOKENS.
IMAP_MCP_TOKEN=change-me-to-a-long-random-token
IMAP_USER=user@example.com
# Use an app password when your provider offers one.
IMAP_PASSWORD=change-me
# Only when the server allows more than one IMAP host.
IMAP_HOST=
