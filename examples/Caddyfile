# Caddy in front of imap-mcp: Caddy ends TLS (automatic certificates) and
# forwards to imap-mcp over plain HTTP on the same host.
#
# imap-mcp runs with:
#   IMAP_MCP_LISTEN=127.0.0.1:8787
#   IMAP_MCP_PUBLIC_URL=https://mail-mcp.example.com
# (In Docker on a shared network, use IMAP_MCP_LISTEN=0.0.0.0:8787,
#  IMAP_MCP_INSECURE_HTTP=true and `reverse_proxy imap-mcp:8787`.)
#
# Every request carries the IMAP password in a header. Do not enable
# request logging that records headers. Caddy's access log ("log" directive)
# writes request headers, so this file has no "log" directive. If you need
# an access log, delete the secret headers from it, as shown below.

mail-mcp.example.com {
	# Uploads: keep at or above IMAP_MCP_MAX_UPLOAD plus multipart overhead.
	request_body {
		max_size 30MB
	}

	reverse_proxy 127.0.0.1:8787 {
		# Downloads stream; do not buffer them.
		flush_interval -1
	}

	# Optional access log without secrets. Uncomment only together with
	# the filter below.
	# log {
	# 	format filter {
	# 		request>headers>Authorization delete
	# 		request>headers>X-Imap-Password delete
	# 		request>headers>X-Imap-Username delete
	# 	}
	# }
}
