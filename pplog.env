# A pair "X.value" + "X.source" (startup env report) is shown as one line: "X = value (source)".
PPLOG_LOGLINE='
{{- if .time }}{{ .time | tmf "2006-01-02T15:04:05Z07:00" "15:04:05" }}{{ end }}
{{- if .level }} {{ if eq .level "DEBUG" }}\e[90m{{ end }}{{ if eq .level "INFO" }}\e[32m{{ end }}{{ if eq .level "WARN" }}\e[93m{{ end }}{{ if eq .level "ERROR" }}\e[91m{{ end }}{{ .level }}\e[0m{{ end }}
{{- if .msg }} \e[97m{{ .msg }}\e[0m{{ end }}
{{- $f := .ALL | rm "time" "level" "msg" }}
{{- $m := dict }}{{ range $f }}{{ $_ := set $m .K .V }}{{ end }}
{{- $multi := gt (len $f) 4 }}
{{- range $f }}
{{- $base := trimSuffix ".value" .K }}
{{- $src := get $m (printf "%s.source" $base) }}
{{- if and (hasSuffix ".source" .K) (hasKey $m (printf "%s.value" (trimSuffix ".source" .K))) }}{{ continue }}{{ end }}
{{- if $multi }}
    {{ else }} {{ end }}
{{- if and (hasSuffix ".value" .K) $src }}\e[33m{{ $base }}\e[0m = {{ .V }} \e[90m({{ $src }})\e[0m
{{- else if $multi }}\e[33m{{ .K }}\e[0m = {{ .V }}
{{- else }}\e[33m{{ .K }}\e[0m={{ .V }}{{ end }}
{{- end }}
'

